# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Compared on the same long dream: 3.6-flash was the only model that tied the
# reading back to what the dreamer said about himself, named the condition by
# its Arabic term (الجاثوم) rather than a borrowed one, and opened by seeking
# refuge for him. The lite models are cheaper and read thinner; they stay in the
# fallback list because a thin answer beats no answer when quota runs out.
# Run `python -m legacy.models` to list models your key can reach.
# Availability differs per key: gemini-2.5-flash 404s on newly created keys.
GEMINI_MODEL=gemini-3.6-flash

# NOTE: on the free tier gemini-3.6-flash allows only 20 requests per day. That
# is enough to develop against and not enough to run a site on; the list below
# is what keeps it answering once that runs out, in descending order of how well
# each one holds the interpreter's voice.
# Free-tier quota is metered PER MODEL, so the server falls through this list
# when one runs dry. That is what keeps the site answering.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Comma-separated origins allowed to call the API, or * while it is read-only.
CORS_ORIGINS=*

# Politeness delay between Shamela requests, in seconds.
SCRAPE_DELAY=1.2
